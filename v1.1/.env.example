# Copy to .env and fill in. Never commit .env.
# Supabase → Project Settings → API

SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# The "service_role" key. Bypasses row-level security — server/CI only.
# Do NOT put this in web/config.js.
SUPABASE_SERVICE_KEY=

# Optional: comma-separated tokens to mark as tier 0 (polled every run).
# WATCHLIST=stripe,ramp,linear
